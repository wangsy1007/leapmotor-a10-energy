# 复制为 .env 后按需修改。切勿把真实 Token / 账号写进仓库。
#
# API_TOKEN 可选：默认留空表示「无需 Token 直连」。
# 若填写非空值，则所有 /api/v1/* 仍要求 Authorization: Bearer <API_TOKEN>。
API_TOKEN=
BIND_PORT=18080
POLL_DRIVING_SECONDS=6
POLL_PARKED_SECONDS=60
BATTERY_USABLE_KWH=50.0
# SQLite 路径；Compose 默认挂载到 /data
DATABASE_PATH=/data/leapmotor.db
TZ=Asia/Shanghai
